# ─── URL pública (obrigatória em produção: canonical, sitemap, Open Graph) ───
NEXT_PUBLIC_SITE_URL=https://www.lab81.com.br

# ─── Armazenamento (VPS) ───
# Pasta onde ficam o banco SQLite e os arquivos enviados. Deve estar FORA da pasta do build
# e com backup. Padrão: ./storage
STORAGE_DIR=./storage

# ─── Painel administrativo ───
ADMIN_EMAIL=
# Gere com: npm run admin:hash -- "sua-senha-forte"
ADMIN_PASSWORD_HASH=
# String aleatória com 32+ caracteres. Gere com: openssl rand -base64 48
SESSION_SECRET=

# ─── Notificação de novos orçamentos (opcional) ───
# E-mail (SMTP). Se vazio, os orçamentos ficam apenas no painel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
QUOTE_NOTIFY_EMAIL=
# Webhook para CRM (n8n, Make, Zapier, RD Station...). Recebe JSON assinado com HMAC-SHA256.
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_SECRET=

# ─── Mensuração (carregada somente após consentimento) ───
NEXT_PUBLIC_GTM_ID=
# Código de verificação do Google Search Console (meta tag)
GOOGLE_SITE_VERIFICATION=
