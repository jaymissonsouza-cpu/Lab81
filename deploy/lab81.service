# /etc/systemd/system/lab81.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now lab81
[Unit]
Description=LAB81 Studio (Next.js)
After=network.target

[Service]
Type=simple
User=lab81
WorkingDirectory=/srv/lab81/app/.next/standalone
EnvironmentFile=/srv/lab81/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# Endurecimento básico
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/srv/lab81/storage

[Install]
WantedBy=multi-user.target
